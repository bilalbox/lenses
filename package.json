{
	"name": "lenses",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"data": "python3 scripts/build_data.py",
		"data:enrichment": "python3 scripts/build_qurandb_enrichment.py",
		"data:syntax": "python3 scripts/build_syntax.py",
		"data:structure": "python3 scripts/build_structure.py",
		"dev": "vite --host 127.0.0.1 --port 43123",
		"build": "tsc -b && vite build",
		"lint": "biome check .",
		"preview": "vite preview --host 127.0.0.1 --port 43123",
		"deploy": "pnpm run build && wrangler deploy",
		"typecheck": "tsc -b",
		"lint:graph": "tsx scripts/run-rev-dep.ts",
		"lint:complexity": "tsx scripts/ratchets/run-complexity.ts",
		"lint:py": "uvx ruff@0.17.2 check . && uvx ruff@0.17.2 format --check . && uvx basedpyright@1.40.2 && uvx tach@0.35.3 check && uvx vulture@2.16 . vulture_whitelist.py",
		"gate:fast": "pnpm lint && pnpm lint:graph && pnpm lint:complexity && pnpm typecheck && pnpm lint:py",
		"gate:fast:py": "pnpm gate:fast && pnpm lint:py",
		"gate": "pnpm gate:fast && pnpm test",
		"test:ratchets": "bash tests/ratchets/ratchet-contract.test.sh",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "husky"
	},
	"dependencies": {
		"@fontsource/literata": "^5.3.0",
		"@fontsource/noto-sans-arabic": "^5.3.0",
		"@fontsource/scheherazade-new": "^5.3.0",
		"@fontsource/source-sans-3": "^5.3.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"rev-dep": "^3.3.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.0.5",
		"wrangler": "^4.152.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261006.1": true
	},
	"packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"engines": {
		"node": ">=24.0.0 <25"
	}
}
