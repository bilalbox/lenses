{
	"name": "lenses",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"data": "python3 scripts/build_data.py",
		"data:enrichment": "python3 scripts/build_qurandb_enrichment.py",
		"data:syntax": "python3 scripts/build_syntax.py",
		"data:mutashabih": "python3 scripts/build_mutashabih.py && python3 scripts/build_mutashabih_quiz.py",
		"data:quiz": "tsx scripts/build_quiz_bank.ts",
		"data:lexicon": "python3 scripts/build_lexicon.py",
		"data:wujuh": "python3 scripts/build_wujuh.py",
		"data:irab": "python3 scripts/build_irab_dictionary.py",
		"audit:wujuh": "python3 scripts/audit_wujuh.py",
		"audit:wujuh:merge": "python3 scripts/audit_wujuh.py --merge",
		"data:all": "pnpm data && pnpm data:syntax && pnpm data:mutashabih && pnpm data:enrichment && pnpm data:lexicon && pnpm data:wujuh && pnpm data:quiz",
		"dev": "vite --host 127.0.0.1 --port 43123",
		"build": "tsc -b && vite build",
		"lint": "tsx scripts/ratchets/run-biome.ts",
		"preview": "vite preview --host 127.0.0.1 --port 43123",
		"deploy": "pnpm run build && wrangler deploy",
		"deploy:preview": "pnpm run build && wrangler preview",
		"typecheck": "tsc -b",
		"lint:graph": "tsx scripts/run-rev-dep.ts",
		"lint:complexity": "tsx scripts/ratchets/run-complexity.ts",
		"lint:py": "uvx ruff@0.17.2 check . && uvx ruff@0.17.2 format --check . && uvx basedpyright@1.40.2 && uvx tach@0.35.3 check && uvx vulture@2.16 . vulture_whitelist.py",
		"gate:fast": "bash tools/quality/js-ts/gate.sh fast lint:py",
		"gate:fast:py": "pnpm lint:py",
		"gate": "bash tools/quality/js-ts/gate.sh full",
		"test:ratchets": "bash tools/quality/ratchets/ratchet-contract.test.sh",
		"test": "vitest run && pnpm test:py",
		"test:py": "uvx pytest@8.4.2 -q",
		"test:watch": "vitest",
		"prepare": "husky",
		"fix": "biome check --write .",
		"lint:secrets": "bash tools/quality/run-secret-scan.sh",
		"lint:vulns": "bash tools/quality/run-vuln-scan.sh",
		"lint:coverage": "bash tools/quality/run-coverage-ratchet.sh"
	},
	"dependencies": {
		"@fontsource/literata": "^5.3.0",
		"@fontsource/noto-sans-arabic": "^5.3.0",
		"@fontsource/scheherazade-new": "^5.3.0",
		"@fontsource/source-sans-3": "^5.3.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@vitest/coverage-v8": "^5.1.0",
		"c8": "^10.1.3",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"rev-dep": "^3.3.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.1.0",
		"wrangler": "^4.161.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261006.1": true
	},
	"packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"engines": {
		"node": ">=24.0.0 <25"
	}
}
