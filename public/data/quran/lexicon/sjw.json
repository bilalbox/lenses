{"r":"sjw","lane":{"p":1312,"e":[{"h":"سَجَا","t":["(S, Msb, K, &c.,) aor. ",[2,"يَسْجُو"],", (S, Msb,) inf. n. ",[2,"سُجُوٌّ"]," (S, K, TA) and ",[2,"سَجْوٌ"],", (TA,) said of the night, (Fr, IAar, Msb, TA,) &c., (TA,) ",[1,"It was,"]," or ",[1,"became, silent, quiet,"]," or ",[1,"still:"]," (Fr, IAar, S, K, TA:) and ",[1,"dark:"]," (Fr, TA:) or ",[1,"its darkness became extended:"]," (IAar, TA:) or ",[1,"it covered,"]," or ",[1,"concealed, by its darkness."]," (Msb, TA.) ",[2,"وَ ٱللَّيْلِ"],[2,"إِذَا سَجَا"],", in the Kur [xciii. 2], means ",[1,"And the night when it becomes still, silent,"]," or ",[1,"quiet:"]," (IAar, Zj, S, Jel:) or ",[1,"when it covers with its darkness:"]," (Jel:) or ",[1,"when its people become silent:"]," or ",[1,"when its darkness becomes still:"]," from ",[2,"سَجَا"],[2,"البَحْرُ"],", inf. n. ",[2,"سُجُوٌّ"],", ",[1,"The sea became calm."]," (Bd.) And one says, ",[2,"سَجَتِ الرِّيحُ"],[1,"The wind became still."]," (TA.) ― -b2- ",[2,"سَجَتِ النَّاقَةُ"],[1,"The she-camel prolonged her"],[2,"حَنِين"]," [or ",[1,"cry of yearning towards her young one"],"]. (K.) ― -b3- See also 2."],"f":"1"},{"h":"سجّى","t":[[1,"He covered"]," anything; as also ↓ ",[2,"اسجى"],", and ↓ ",[2,"سَجَا"],". (IAar, TA.) You say, ",[2,"سجّى المَيِّتَ"],", (S, Mgh, Msb,) inf. n. ",[2,"تَسْجَيةٌ"],", (S, Mgh, K,) ",[1,"He covered the dead person"]," (Mgh, Msb, K) with a garment, or piece of cloth, (Mgh, Msb,) and the like. (Msb.)"],"f":"2"},{"h":"ساجاهُ","t":["(K,) inf. n. ",[2,"مُسَاجَاةٌ"],", (TA,) ",[1,"He touched it."]," (K.) One says, ",[2,"أَتَانَا بِطَعَامٍ فَمَا سَاجَيْنَاهُ"]," i. e. [",[1,"He brought us food, and"],"] ",[1,"we did not touch it."]," (AZ, TA.) ― -b2- And ",[1,"i. q."],[2,"عَالَجَهُ"]," [meaning ",[1,"He worked,"]," or ",[1,"laboured, upon it,"]," or ",[1,"at it;"]," &c.]. (K.) One says, ",[2,"هَلْ تُسَاجِى ضَيْعَةً"]," i. e. ",[2,"تُعَالِجُهَا"]," [meaning ",[1,"Dost thou work,"]," or ",[1,"labour, upon a landed estate?"]," or, probably, ",[1,"dost thou cultivate a landed estate by the work,"]," or ",[1,"labour, of others?"],"]. (Aboo-Málik, TA.)"],"f":"3"},{"h":"أَسْجَوَ","t":["see 2. -A2- ",[2,"اسجت النَّاقَةُ"],[1,"The she-camel had much milk."]," (Sgh, K.)"],"f":"4"},{"h":"سَجِىٌّ","t":["[ ",[1,"A sincere companion"]," and ",[1,"friend."]," (Golius, from Meyd.)]"]},{"h":"سَجِيَّةٌ","t":[[1,"A nature;"]," or ",[1,"a natural, a native,"]," or ",[1,"an innate, disposition"]," or ",[1,"temper"]," or ",[1,"the like;"]," syn. ",[2,"خُلُقٌ"],", and ",[2,"طَبِيعَةٌ"],", (S,) or ",[2,"غَرِيزَةٌ"],": (Msb:) or ",[1,"a faculty,"]," or ",[1,"quality, firmly rooted in the mind, not easy of removal:"]," (MF:) pl. ",[2,"سَجَايَا"],". (Msb.)"]},{"h":"نَاقَةٌ سَجْوَآءُ","t":[[1,"A she-camel still,"]," or ",[1,"quiet, when being milked."]," (M, K.) ― -b2- And ",[1,"A she-camel whose fur is unruffled:"]," and ",[2,"شَاةٌ سَجْوَآءُ"],[1,"a sheep whose wool is unruffled."]," (TA.) ― -b3- And ",[2,"رِيحٌ سَجْوَآءُ"],[1,"A gentle wind."]," (TA.) ― -b4- And ",[2,"اِمْرَأَةٌ سَجْوَآءُ الطَّرْفِ"]," i. e. ↓ ",[2,"سَاجِيَتُهُ"],", (K,) meaning ",[1,"A woman languid,"]," or ",[1,"languishing, in the eye."]," (TA.)"]},{"h":"سَاجٍ","t":[[1,"Still, silent,"]," or ",[1,"quiet:"]," thus applied to the sea [as meaning ",[1,"calm,"]," or ",[1,"unruffled"],"]. (S, K.) And ",[2,"لَيْلَةٌ سَاجِيَةٌ"],[1,"A calm night, in which the wind is still, and such as is not dark:"]," (T, TA:) or ",[1,"a night in which the cold has become allayed, and in which the wind and the clouds have become still, and which is not dark."]," (M, TA.) And ",[2,"طَرْفٌ سَاجٍ"],[1,"A still,"]," or ",[1,"motionless, eye:"]," (S, K:) [or] ",[2,"عَيْنٌ سَاجِيَةٌ"],", accord. to IAar, means ",[1,"an eye that has a languid,"]," or ",[1,"languishing, look;"]," which is an accessory to beauty in women. (TA.) See also the next preceding paragraph."]}]},"maqayis":["السين والجيم والواو أصل يدل على سكون وإطباق. يقال سجا الليل، إذا ادلهم وسكن. وقال: يا حبذا القمراء والليل الساج ... وطرق مثل ملاء النساج وطرف ساج، أي ساكن."],"mufradat":["قال تعالى: والليل إذا سجى [الضحى/ 2] ، أي: سكن، وهذا إشارة إلى ما قيل: هدأت الأرجل، وعين ساجية: فاترة الطرف، وسجى البحر سجوا: سكنت أمواجه، ومنه استعير: تسجية الميت، أي: تغطيته بالثوب."]}