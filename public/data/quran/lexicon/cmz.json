{"r":"$mz","lane":{"p":1596,"e":[{"h":"شَمَزَتْ نَفْسِى مِنْهُ","t":["aor. , (TK,) inf. n. ",[2,"شَمْزٌ"],", (IAar, K,) ",[1,"My soul shrank from it in dislike"]," or ",[1,"hatred."]," (IAar, K, TK.) [See also 5, and Q. Q. 4.]"],"f":"1"},{"h":"تشمّز وَجْهُهُ","t":[[1,"His face became changed,"]," or ",[1,"altered,"]," (T, S, K,) ",[1,"by anger,"]," (K,) ",[1,"and contracted."]," (T, S, K.) See also what next follows."],"f":"5"},{"h":"اِشْمَأَزَّ","t":["(S, K,) inf. n. ",[2,"اِشْمِئْزَازٌ"],", (S,) ",[1,"He"]," (a man, S) ",[1,"shrank,"]," or ",[1,"became contracted;"]," (S, K, TA;) as also ↓ ",[2,"تشمّز"],": (TA:) ",[1,"he quaked,"]," or ",[1,"shuddered:"]," (IAar, K:) or ",[1,"he was frightened"]," (AZ, S, K) at a thing. (AZ, S.) It is said in the Kur xxxix. 46, ",[2,"وَإِذَا ذُكِرَ ٱللّٰهُ وَحْدَهُ ٱشْمَأَزَّتْ قُلُوبُ ٱلَّذِينَ"],[2,"لَا يُؤْمِنُونَ بِٱلْآخِرَةِ"],[1,"And when God is mentioned alone, the hearts of those who will not believe in the world to come become contracted, and shrink with aversion:"]," (Bd, Jel:) or ",[1,"quake,"]," or ",[1,"shudder."]," (Zj, TA.) And you say, ",[2,"قُلْتُ لَهُ كَذَا فَٱشْمَأَزَّ مِنْهُ"]," [",[1,"I said to him such a thing, and he shrank from it;"]," or ",[1,"quaked,"]," or ",[1,"shuddered, at it;"]," or ",[1,"was frightened at it"],"]. (A.) And ",[2,"اشمأزّ الشَّىْءَ"],", (K,) without a prep., accord. to Kr, (TA,) ",[1,"He disliked,"]," or ",[1,"hated, the thing."]," (K.) [See also 1, and 5.]"],"f":"Q. Q. 4"},{"h":"شُمَأْزِيزَةٌ","t":["[a subst.] from Q. Q. 4, [",[1,"A shrinking,"]," or ",[1,"contraction: a quaking,"]," or ",[1,"shuddering:"]," or ",[1,"fright:"]," and ",[1,"dislike,"]," or ",[1,"hatred."],"] (S, K, * TA.) You say, ",[2,"رَجُلٌ فِيهِ شُمَأْزِيزَةٌ"]," [",[1,"A man in whom is a shrinking,"]," &c.] (TA.)"]},{"h":"مُشْمَئِزٌّ","t":[[1,"Shrinking with aversion;"]," syn. ",[2,"نَافِرٌ"],": (K:) ",[1,"disliking,"]," or ",[1,"hating,"]," (K,) a thing: (TA:) ",[1,"frightened,"]," or ",[1,"afraid."]," (K.)"]}]}}