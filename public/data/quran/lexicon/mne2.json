{"r":"mnE","lane":{"p":3024,"e":[{"h":"مَنَعَ","t":[[1,"He prevented, hindered, held back,"]," [",[1,"impeded, withheld, arrested, restrained, kept, debarred, precluded, inhibited, forbade, prohibited, interdicted:"],"] (MA, KL, &c.:) ",[1,"he denied,"]," or ",[1,"refused;"]," doubly trans.; (S, K, &c.:) ",[2,"مَنْعٌ"]," is the ",[1,"contr. of"],[2,"إِعْطَآءٌ"],". (S, Mgh, K.) ― -b2- ",[2,"مَنَعَهُ"]," [",[1,"He protected it,"]," or ",[1,"defended it,"]," or ",[1,"guarded it,"]," (namely a place or the like) ",[1,"from,"]," or ",[1,"against, encroachment, invasion,"]," or ",[1,"attack:"],"] ",[1,"he protected, defended,"]," or ",[1,"guarded, him."]," (T in art. ",[2,"ذب"],".) ― -b3- ",[2,"مَنَعَهُ العَطِيَّةُ"]," [",[1,"He refused him the gift"],"]. (TA in art. ",[2,"حرم"],".) ― -b4- ",[2,"مَنَعَهُ الشَّىْءَ"],[1,"i. q."],[2,"حَرَمَهُ إِيَّاهُ"]," [q. v.] (S in art. ",[2,"حرم"],".) ― -b5- ",[2,"مَنُعَ الشَّىْءُ"],", inf. n. ",[2,"مَنَاعَةٌ"],", ",[1,"i. q."],[2,"اِعْتَزَّ"]," and ",[2,"تَعَسَّرَ"],". (TA.) See 8. ― -b6- ",[2,"مَا مَنَعَكَ أَلَّا تَسْجُدَ"]," (Kur vii. 11): see ",[2,"أَبَى"],"."],"f":"1"},{"h":"مَانَعَهُ الشَّىْءَ","t":[[1,"He disputed,"]," or ",[1,"contested, with him the thing:"]," (Msb:) ",[1,"he refused him the thing:"]," (TK:) ",[1,"he endeavoured,"]," or ",[1,"contended with him, to make him,"]," or ",[1,"to entice him, to abstain from,"]," or ",[1,"relinquish, the thing;"]," (TA;) [",[1,"he endeavoured to turn him away from the thing; to prevent his obtaining it"]," or ",[1,"doing it; he prevented him from obtaining"]," or ",[1,"doing the thing, being also prevented by him;"]," i. e. ",[1,"he reciprocally prevented him,"]," &c.: and hence the meaning in the TA; and then that in the Msb:] ",[2,"مَانَعُوا عَدُوَّهُمْ"]," signifies ",[1,"i. q."],[2,"حَاجَزُوهُمْ"],": (TK, art. ",[2,"حجز"],":) see the latter. ― -b2- ",[2,"تَمَنَّعَ عَلَى السَّنَةِ"]," [",[1,"he resisted,"]," or ",[1,"withstood, the year of dearth"],"]: said of an animal. (K.)"],"f":"3"},{"h":"تَمَنَّعَ مِنَ الشَّىْءِ بِقَّوْمِهِ","t":["and ↓ ",[2,"اِمْتَنَعَ"],[1,"He became strengthened,"]," or ",[1,"fortified, against the thing by his people,"]," or ",[1,"party;"]," syn. ",[2,"تَقَوَّى"],". (Msb.) ― -b2- ",[2,"تَمَنَّعَ عَنْهُ"],[1,"He refrained, forbore,"]," or ",[1,"abstained, from it, as being forbidden,"]," or ",[1,"prohibited."]," (K, * TA.) See 8. ― -b3- ",[2,"تَمَنَّعَ بِهِ"]," and ",[2,"بِهِ"]," ↓ ",[2,"اِمتنع"],[1,"he protected,"]," or ",[1,"defended, himself by it,"]," namely a fortress; syn. ",[2,"اِحْتَمَى"],". (TA.)"],"f":"5"},{"h":"تَمَانَعَا","t":[[1,"i. q."],[2,"تَحَاجَزَا"],": (K, art. ",[2,"حجز"],":) see the latter."],"f":"6"},{"h":"اِمْتَنَعَ","t":["[",[1,"It was,"]," or ",[1,"became, prevented from being; it necessarily was not."]," You say ",[2,"يَمْتَنِعُ"],[2,"هٰذَا لِوُجُودِ ذَاكَ"],[1,"This is prevented from being,"]," or ",[1,"may not be,"]," or ",[1,"necessarily is not, because of that's being."]," And ",[2,"يَمْتَنِعُ أَنْ تَكُوَن هٰذَا"],[1,"This may not be."],"] ― -b2- ",[2,"اِمْتَنَعَ"],[1,"He refrained, forbore, abstained,"]," or ",[1,"held back,"]," (Msb, K,) ",[2,"مِنَ الأَمْرِ"],[1,"from the thing."]," or ",[1,"affair;"]," (Msb;) as also ",[2,"عَنْهُ"]," ↓ ",[2,"تَمَنَّعَ"],": (TA:) ",[1,"he did so voluntarily, of his own free will"]," or ",[1,"choice: he refused:"]," you say, ",[2,"اِمْتنَعَ عَنْهُ"],[1,"he refrained,"]," &c., ",[1,"from it voluntarily,"]," &c.; ",[1,"refused it;"]," or ",[1,"refused to do it."]," (MF. in art. ",[2,"حصر"],".) See ",[2,"أَبَى"],". ― -b3- ",[2,"اِمْتَنَعَ"],[2,"عَلَيْهِ"],[1,"He,"]," or ",[1,"it, opposed him; resisted him; withstood him; repugned him; was incompliant,"]," or ",[1,"unyielding, to him;"]," see ",[2,"أَبَى عَلَيْهِ"],". ― -b4- ",[2,"اِمْتَنَعَ"],[1,"It was,"]," or ",[1,"became, inaccessible,"]," or ",[1,"inapproachable;"]," like ↓ ",[2,"مَنُعَ"],"; syn. with ",[2,"حَصُنَ"],", q. v.: and also, ",[1,"difficult of access,"]," as in an instance in art. ",[2,"أبى"]," (last sentence of 4); and also ",[2,"عَرِسَ عَلَىَّ"],". ― -b5- See 5."],"f":"8"},{"h":"مَِنْعَةٌ","t":[": see ",[2,"مَنَعَةٌ"],"."]},{"h":"مَنَعَةٌ","t":[[1,"State,"]," and ",[1,"power, of resistance;"]," lit. ",[1,"a state of might of one's people"]," or ",[1,"party, so that such as desires to do so will not prevail against him:"]," [or ",[1,"a state of might in his people"]," or ",[1,"party,"]," &c.; or ",[1,"a state of might, and power of resistance, in his people"]," or ",[1,"party:"],"] (Msb:) [",[1,"resistibility:"]," or simply ",[1,"resistance:"],"] ",[1,"inaccessibleness,"]," or ",[1,"unapproachableness,"]," of a people; as also ↓ ",[2,"مَنْعَةٌ"]," and ↓ ",[2,"مِنْعَةٌ"],". (TA.)"]},{"h":"مَنُوعٌ","t":["One ",[1,"who denies,"]," or ",[1,"refuses to give;"]," as also ↓ ",[2,"مَانِعٌ"]," and ↓ ",[2,"مَنَّاعٌ"],". (K.)"]},{"h":"مَنِيعٌ","t":["from ",[2,"مَنُعَ"],", [",[1,"Unapproachable; inaccessible:"],"] ",[1,"difficult of access; fortified; strong:"]," (TK, voce ",[2,"وَزَرٌ"],":) [",[1,"defended,"]," or ",[1,"protected, against attack:"]," like ",[2,"حَصِينٌ"],": ",[1,"resistive; resisting attack;"],"] applied to a fortress. (Msb.) ― -b2- ",[2,"قَوْمٌ مُنَعَآءُ"]," [pl. of ",[2,"مَنِيعٌ"],"] ",[1,"An inaccessible,"]," or ",[1,"unapproachable, people."]," (TA.)"]},{"h":"مَنَّاعٌ","t":[[2,"مَنُوعٌ"],"."]},{"h":"مَانِعٌ","t":[[2,"مَنُوعٌ"],"."]},{"h":"المُتَمَنِّعَانِ","t":[[1,"The young she-camel and young she-kid:"]," because they resist the year of dearth by reason of their youthful vigour, &c. (K.)"]},{"h":"مُمْتَنِعٌ","t":[[1,"Resisting; resisting attack; unyielding; incompliant."]]}]},"maqayis":["الميم والنون والعين أصل واحد هو خلاف الإعطاء. ومنعته الشيء منعا، وهو مانع ومناع. ومكان منيع. وهو في عز ومنعة."],"mufradat":["المنع يقال في ضد العطية، يقال: رجل مانع ومناع. أي: بخيل. قال الله تعالى: ويمنعون الماعون [الماعون/ 7] ، وقال: مناع للخير [ق/ 25] ، ويقال في الحماية، ومنه: مكان منيع، وقد منع وفلان ذو منعة. أي: عزيز ممتنع على من يرومه. قال تعالى: ألم نستحوذ عليكم ونمنعكم من المؤمنين [النساء/ 141] ، ومن أظلم ممن منع مساجد الله [البقرة/ 114] ، ما منعك ألا تسجد إذ أمرتك [الأعراف/ 12] أي: ما حملك؟","وقيل: ما الذي صدك وحملك على ترك ذلك؟","يقال: امرأة منيعة كناية عن العفيفة. وقيل: مناع. أي: امنع، كقولهم: نزال. أي: انزل."]}