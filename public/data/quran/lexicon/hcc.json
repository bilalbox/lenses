 [app. meaning ",[1,"the shores of 'Omán"],"] ",[1,"in particular."]," (TA.) -A2- See also ",[2,"هَشٌّ"],", in three places. ― -b2- Also, (assumed tropical:) A man ",[1,"who is niggardly towards his family,"]," or ",[1,"others, with respect to food;"]," syn. ",[2,"مُحْتِرٌ"],". (TA.) [Thus it bears two contr. significations.]"]},{"h":"هَشِيشَةٌ","t":["is thought by ISd to signify ",[1,"Leaves"]," [app. ",[1,"beaten from a tree"],"]. (TA.)"]},{"h":"قِرْبَةٌ هَشَّاشَةٌ","t":[[1,"A water-skin from which the water flows by reason of its thinness."]," (K.)"]},{"h":"هَشْهَشَةٌ","t":["(assumed tropical:) ",[1,"Motion;"]," or ",[1,"commotion."]," (JK.) [",[2,"هَشَاهِشُ"]," is app. its pl.: see 1, next before ",[2,"هَشَّ"],[2,"الوَرَقَ"],".]"]},{"h":"هَشْهَاشٌ","t":["(tropical:) ",[1,"Good in disposition; liberal,"]," or ",[1,"bountiful."]," (IAar, K.)"]},{"h":"هَاشٌّ","t":[": see ",[2,"هَشٌّ"],", in three places."]},{"h":"مُهَشْهِشَةٌ","t":["in the copies of the K erroneously written ",[2,"مُتَهَشْهِشَة"],", (TA,) (assumed tropical:) A woman ",[1,"who manifests love to her husband, and rejoices in him."]," (K, * TA.)"]}]},"maqayis":["الهاء والشين: أصل صحيح يدل على رخاوة ولين. والرخو اللين هش. ومنه رجل هش: طلق المحيا، وقد هششت، وذو هشاش. والفرس الهش: الكثير العرق. وشاة هشوش: ثرة.","ومن الباب هششت الورق هشا: خبطته بعصا."],"mufradat":["[طه/ 18] وهش الرغيف في التنور يهش، وناقة هشوش: لينة غزيرة اللبن، وفرس هشوش : ضد الصلود، والصلود: الذي لا يكاد يعرق.","ورجل هش الوجه: طلق المحيا، وقد هششت، وهش للمعروف يهش، وفلان ذو هشاش."]}