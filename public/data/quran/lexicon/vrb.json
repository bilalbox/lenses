ب عَلَيْهِ"],", (S, M, K,) and ",[2,"ثّربهُ"],"; (A, K;) and ↓ ",[2,"ثَرَبَهُ"],", [and ",[2,"ثَرَبَ عليه"],",] aor. , (K,) inf. n. ",[2,"ثَرْبٌ"],"; (TK;) and ↓ ",[2,"اثربهُ"],"; (A, K;) (assumed tropical:) ",[1,"he blamed him,"]," or ",[1,"reproved him; upbraided him,"]," or ",[1,"reproached him,"]," (M, A, K,) ",[1,"with,"]," or ",[1,"for, his offence,"]," or ",[1,"crime;"]," (M, K;) and ",[1,"reminded him thereof;"]," (M;) ",[1,"he showed him his deed to be foul, abominable,"]," or ",[1,"bad:"]," (As, S:) or ",[2,"عليه"]," ↓ ",[2,"ثَرَبَ"],", aor. , signifies (assumed tropical:) ",[1,"he blamed him,"]," or ",[1,"reproved him;"]," and, as Suh says, ",[2,"ثرّب عليه"],", (assumed tropical:) ",[1,"he blamed him,"]," or ",[1,"reproved him, much."]," (Msb.) ― -b3- Also (assumed tropical:) The ",[1,"acting ill,"]," or ",[1,"corruptly; doing evil,"]," or ",[1,"mischief; creating confusion,"]," or ",[1,"disorder."]," (TA.) -A2- It is also said in the K to be ",[1,"syn. with"],[2,"طَىٌّ"],", which means The ",[1,"building"]," [or ",[1,"casing"]," a well] ",[1,"with stones:"]," but [SM says,] I fear that this is a mistranscription for ",[2,"تَثْوِيبٌ"],", with ",[2,"و"],". (TA.)"],"f":"2"},{"h":"أَثْرَبَ","t":[[1,"He"]," (a ram) ",[1,"increased in his fatness:"]," (K:) or ",[1,"acquired a"],[2,"ثَرْب"],", ",[1,"having increased in fatness."]," (TA.) -A2- See also 2, in two places."],"f":"4"},{"h":"ثَرْبٌ","t":[[1,"A thin integument of fat that covers the stomach of a ruminant and the bowels"]," or ",[1,"intestines;"]," (Lth, T, S, M, Msb, K;) the ",[1,"fat that is spread over the bowels,"]," or ",[1,"intestines:"]," (T:) pl. (of mult., TA) ",[2,"ثُرُوبٌ"]," (M, K) and (of pauc., TA) ",[2,"أَثْرُبٌ"],", and pl. pl. ",[2,"أَثَارِبُ"],". (K.) Hence, ",[2,"صَارَتِ"],[2,"الشَّمْسُ كَٱلْأَثَارِبِ"],[1,"The sun"]," [upon the ground] ",[1,"became like the integuments above-mentioned:"]," i. e., scattered; being upon one place and not upon another, towards sunset: a phrase occurring in a trad., in which it is said that when this is the case, it is forbidden to perform the afternoonprayer: and in another trad. occurs the phrase, ",[2,"صَارَتِ الشَّمْسُ كَثَرْبِ النَّاقَةِ"]," [",[1,"The sun"]," upon the ground ",[1,"became like the"],[2,"ثرب"],[1,"of the she-camel"],"]. (TA.) ― -b2- And [hence,] (assumed tropical:) ",[1,"A land of which the stones are such as those of the"],[2,"حَرَّة"]," [q. v.], ",[1,"save that they are white."]," (L.)"]},{"h":"ثَرَبَاتٌ","t":["(K,) or ",[2,"ثَرِبَاتٌ"]," [like ",[2,"تَرِبَاتٌ"],", with which it is nearly, or perhaps exactly, syn.], (M,) The ",[1,"fingers."]," (M, K.)"]},{"h":"أَثْرَبُ","t":["(TA,) fem. ",[2,"ثَرْبَآءُ"],", (T, K,) A sheep ",[1,"having a large"],[2,"ثَرْب"],"; (T, TA;) i. e. (TA) a ",[1,"fat"]," sheep. (K, TA.)"]},{"h":"مُثْرِبٌ","t":["(assumed tropical:) One ",[1,"who gives little,"]," (K, TA,) ",[1,"reproaching for that which he has given."]," (TA.)"]},{"h":"مُثَرِّبٌ","t":[[1,"Upbraiding"]," [&c.: see the verb, 2]: (M:) or ",[1,"acting ill,"]," or ",[1,"corruptly; doing evil,"]," or ",[1,"mischief; creating confusion,"]," or ",[1,"disorder."]," (M, K.)"]}]},"maqayis":["الثاء والراء والباء كلمتان متباينتا الأصل، لا فروع لهما. فالتثريب اللوم والأخذ على الذنب. قال الله تعالى: {لا تثريب عليكم اليوم} [يوسف: 92] فهذا أصل واحد. والآخر الثرب، وهو شحم قد غشى الكرش والأمعاء رقيق ; والجمع ثروب."],"mufradat":["التثريب: التقريع والتقرير بالذنب. قال تعالى: لا تثريب عليكم اليوم [يوسف/ 92] ، وروي: «إذا زنت أمة أحدكم فليجلدها ولا يثربها» ، ولا يعرف من لفظه إلا قولهم: الثرب، وهو شحمة رقيقة، وقوله تعالى: يا أهل يثرب [الأحزاب/ 13] ، أي: أهل المدينة، يصح أن يكون أصله من هذا الباب والياء تكون فيه زائدة."]}