{"r":"lzm","lane":{"p":3009,"e":[{"h":"لَزِمَهُ","t":[[1,"It necessarily,"]," or ",[1,"inseparably, belonged,"]," or ",[1,"pertained,"]," or ",[1,"it clave,"]," or ",[1,"adhered, to him,"]," or ",[1,"it;"]," as also ",[2,"لَزِمَ لَهُ"],": ",[1,"it"]," (disgrace, &c.) ",[1,"attached to him."]," ― -b2- ",[2,"لَزِمَهُ أَمْرُ فُلَانٍ"],[1,"The management of the affair,"]," or ",[1,"affairs, of such a one was,"]," or ",[1,"became, incumbent,"]," or ",[1,"obligatory, upon him."]," ― -b3- ",[2,"لَزِمَ شَيْئًا"],[1,"He kept close, clave, clave fast, clung,"]," or ",[1,"held fast, to anything."]," (S, K, &c.) And hence, ",[1,"He preserved a thing:"]," see ",[2,"قَنِىَ"],". ― -b4- See 3. ― -b5- ",[2,"لَزمَ الغَرِيمَ"],", and ",[2,"لَزِمَ بِهِ"],", and ↓ ",[2,"لَازَمَهُ"],", ",[1,"He adhered, kept, clave, clung,"]," or ",[1,"held fast, to the debtor."]," (Msb.) ― -b6- ",[2,"لَزِمَ بَيْتَهُ"],[1,"He kept,"]," or ",[1,"clave, to his house"]," or ",[1,"tent; did not quit it; was not found elsewhere."]," (Kull, p. 318.) ― -b7- ",[2,"لَزِمَهُ المَالُ"],[1,"The"]," [",[1,"paying of the"],"] ",[1,"money &c. behoved him, lay on him, was incumbent on him,"]," or ",[1,"obligatory on him."]," (Msb.)"],"f":"1"},{"h":"لَازَمَهُ","t":[[1,"He kept, confined himself, clave, clung,"]," or ",[1,"held fast, to him, or it:"]," as also ↓ ",[2,"لَزِمَهُ"],": ",[1,"he held on,"]," or ",[1,"continued, it."]," See 1."],"f":"3"},{"h":"أَلْزَمَهُ شَيْئًا","t":["signifies ",[1,"He necessitated him,"]," or ",[1,"obliged him, to do,"]," and ",[1,"to pay,"]," &c.; or ",[1,"to suffer,"]," or ",[1,"endure, a thing:"]," and hence, said of God, ",[1,"He decreed;"]," or ",[1,"appointed,"]," or ",[1,"ordained, to him a thing."]," And ",[1,"He made him to cleave to a thing;"]," and ",[1,"he made a thing to cleave to him."]," See ",[2,"جَدَعَ"],". ― -b2- ",[2,"أُلْزِمَ شَيْئًا لَا يُفَارِقُهُ"]," [",[1,"He was made to cleave to a thing, not quitting it"],"]. (K.) ― -b3- ",[2,"أَلْزَمَهُ اللّٰهُ الشَّرَّ"],[1,"May God make evil to cleave to him:"]," or, ",[1,"to attend him constantly:"]," or ",[1,"decree evil to him."]," ― -b4- ",[2,"أَلْزَمَنَاهُ طَائِرَهُ فِى عُنُقِهِ"],", (Kur xvii. 14,) ",[1,"We have decreed to him his happiness"]," or ",[1,"his misery,"]," foreseeing that he would be obedient, or disobedient: (AM, in TA, art. ",[2,"طير"],":) or ",[1,"we have made his works"]," and ",[1,"what is decreed to him to cleave"]," to him like the ",[2,"طَوْق"],[1,"upon his neck."]," (Bd.) ― -b5- ",[2,"أَلْزَمَهُ البَيِّنَةَ"],[1,"He compelled him,"]," or ",[1,"constrained him, to accept,"]," or ",[1,"admit, the evidence,"]," or ",[1,"proof."]," (Jel xi. 30.) ― -b6- ",[2,"أَلْزَمَهُ المَالَ"],[1,"He obliged him to pay the money &c."],[2,"أَلْزَمَهُ العَمَلَ"],[1,"He obliged him to do the deed."]," (Msb.) ― -b7- ",[2,"أَلْزَمْتُهُ الدَّنْبَ"],", and ",[2,"الحَقَّ"],": see ",[2,"زَكَّ"],". ― -b8- ",[2,"أَلْزِمْ نَعْلَيْكَ قَدَمَيْكَ"]," [",[1,"Keep thou thy sandals upon thy feet"],"]. (From a trad. in the Jámi' es- Sagheer.)"],"f":"4"},{"h":"اِلْتَزَمَ","t":[[1,"He took upon himself"]," an affair. (KL.) You say, ",[2,"اِلْتَزَمَهُ"],[1,"He took it upon himself; charged himself with it; obliged himself to do it; became,"]," or ",[1,"made himself, answerable for it by an inseparable obligation:"]," see ",[2,"بَآءَ"],". ― -b2- ",[2,"اِلْتَزَمْتُ بَالمَالِ"],[1,"i. q."],[2,"أَلْزَمْتُ بِهِ نَفْسِى"],", and ",[2,"تَكَفَّلْتُ"],[2,"بَهَ"],", accord. to IAmb, or ",[2,"تَحَمَّلْتُ بِهِ"],", accord. to AZ; (Msb in art. ",[2,"كفل"],";) ",[1,"I made myself answerable, responsible"]," or ",[1,"accountable, by an inseparable obligation, for the property:"]," see ",[2,"ضَمِنَ"],". ― -b3- ",[2,"اِلْتَزَمَ"],[2,"المَالَ"],", and ",[2,"العَمَلَ"],", ",[1,"He obliged himself,"]," or ",[1,"took upon himself the obligation, to pay the money &c., and to do the deed."]," (Msb.) ― -b4- ",[2,"اِلْتَزَمَهُ"],[1,"He kept,"]," or ",[1,"restricted himself, to it;"]," i. e. an action, or usage, &c. ― -b5- And ",[1,"It was,"]," or ",[1,"became, necessary for him,"]," or ",[1,"obligatory upon him, to do it,"]," or ",[1,"pay it,"]," &c.; or ",[1,"to suffer it,"]," or ",[1,"endure it."]," ― -b6- ",[2,"دَلَفَ لِٱلْتِزَامِى"],[1,"He hastened to take me by the hand and embrace me:"]," see ",[2,"دَلَفَ"],". ― -b7- ",[2,"اِلْتِزَامٌ"],[1,"i. q."],[2,"لُزُومُ مَا لَا يَلْزَمُ"],": see below."],"f":"8"},{"h":"اِسْتَلْزَمَهُ","t":[[1,"It necessarily required it"]," or ",[1,"involved it."]],"f":"10"},{"h":"لَزُومٌ","t":["One ",[1,"who keeps, cleaves, clings,"]," or ",[1,"holds fast, much,"]," or ",[1,"habitually,"],[2,"لِشَىْءٍ"],[1,"to a thing:"]," see an ex. in the Ham, p. 238, line 21."]},{"h":"لُزُومُ مَا لَا يَلْزَمُ","t":[[1,"The imposing upon one's self what is not indispensable;"]," or ",[1,"adhering to a mode of construction that is not necessarily to be followed:"]," as in the following instance in the ",[2,"خُطْبَة"]," of the Kámoos: ",[2,"وَبَلَغُوا مِنَ الْمَقَاصِدِ قَاصِيَتَهَا وَمَلَكُوا مِنَ"],[2,"المَحَاسِنِ نَاصِيَتَهَا"],"."]},{"h":"لَازِمٌ","t":[[1,"Keeping, keeping close, cleaving,"]," &c.; ",[1,"tenacious:"]," and ",[1,"pertinacious."]," ― -b2- ",[2,"لَازِمٌ"],[1,"A thing inseparable from another thing:"]," pl. ",[2,"لَوَازِمُ"],". (TA.) ",[1,"Such as cleaves fast; inseparable:"]," as an epthet. ― -b3- ",[2,"إِسْمٌ لَازِمٌ"],": see ",[2,"جَمْعٌ"],", as signifying “ a plural. ” ― -b4- ",[2,"لَوَازِمُ"],[1,"Necessary,"]," or ",[1,"inseparable, adjuncts, accompaniments, consequences,"]," or ",[1,"results."]]},{"h":"أَلْزَمُ","t":["as syn. with ",[2,"أَقْنَى"]," in the prov. ",[2,"خَلَاؤُكَ"],[2,"أَقْنَى لِحَيَائِكَ"]," means ",[1,"Most preservative:"]," see that prov. in art. ",[2,"خلو"],", and see ",[2,"قَنِىَ الحَيَآءَ"],", and ",[2,"لَزِمَ"],[2,"شَيْئًا"],"."]}]},"maqayis":["اللام والزاء والميم أصل واحد صحيح، يدل على مصاحبة الشيء بالشيء دائما. يقال: لزمه الشيء يلزمه. واللزام: العذاب الملازم للكفار."],"mufradat":["لزوم الشيء: طول مكثه، ومنه يقال: لزمه يلزمه لزوما، والإلزام ضربان: إلزام بالتسخير من الله تعالى، أو من الإنسان، وإلزام بالحكم والأمر. نحو قوله: أنلزمكموها وأنتم لها كارهون [هود/ 28] ، وقوله: وألزمهم كلمة التقوى [الفتح/ 26] ، وقوله: فسوف يكون لزاما [الفرقان/ 77] أي: لازما. وقوله: ولولا كلمة سبقت من ربك لكان لزاما وأجل مسمى [طه/ 129] ."]}