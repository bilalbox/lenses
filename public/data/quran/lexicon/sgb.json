{"r":"sgb","lane":{"p":1367,"e":[{"h":"سَغِبَ","t":["aor. ; (S A, Msb, K;) and ",[2,"سَغَبَ"],", aor. ; (A, K;) inf. n. ",[2,"سَغَبٌ"],", (S, A, * Msb, K,) which is of the former, (Sudot;, Msb, TA,) and ",[2,"سَغْبٌ"],", (K,) which is of the latter, (TA,) and ",[2,"سُغُوبٌ"]," (K) and ",[2,"سَغَابَةٌ"]," and ",[2,"مَسْغَبَةٌ"],", (A, * K,) the last syn. with ",[2,"مَجَاعَةٌ"],"; (S, Msb;) ",[1,"He was,"]," or ",[1,"became, hungry:"]," (S, A, Msb, K:) or ",[1,"suffered hunger together with fatigue."]," (A, Msb, K.) You say, ",[2,"بِهِ سَغَبٌ"]," and ",[2,"مَسْغَبَةٌ"]," and ",[2,"سَغَابَةٌ"],", [using these ns. as simple substs.,] ",[1,"In him is hunger:"]," or ",[1,"hunger together with fatigue."]," (A.) And ",[2,"يَتِيمٌ ذُو مَسْغَبَةٍ"]," [",[1,"An orphan"],"] ",[1,"having hunger."]," (S.) And ",[2,"فِى يَوْمٍ ذِى"],[2,"مَسْغَبَةٍ"],", in the Kur [xc. 14], means ",[1,"In a day of hunger."]," (TA.) [See also ",[2,"سَغْبَةٌ"]," and ",[2,"سَغَبٌ"]," below.]"],"f":"1"},{"h":"اسغب","t":[[1,"He"]," (a man, TA) ",[1,"entered upon a state of hunger."]," (K.)"],"f":"4"},{"h":"سَغَبٌ","t":["an inf. n. of ",[2,"سَغِبَ"]," [q. v.]. (S, &c.) ― -b2- It also signifies ",[1,"Thirst:"]," but is unused: (K:) [or] thirst is sometimes thus termed. (Msb.)"]},{"h":"سَغِبٌ","t":[": see ",[2,"سَاغِبٌ"],"."]},{"h":"سَغْبَةٌ","t":[[1,"Hunger:"]," or ",[1,"hunger combined with fatigue."]," (TA.) [See also 1.]"]},{"h":"سَغْبَانُ","t":["; and its fem., ",[2,"سَغْبَى"],": see the next paragraph, in three places."]},{"h":"سَاغِبٌ","t":["and ↓ ",[2,"سَغْبَانُ"]," (S, A, Msb, K) and ↓ ",[2,"سَغِبٌ"]," (K) ",[1,"Hungry:"]," (S, A, Msb, K, TA:) or ",[1,"suffering hunger together with fatigue:"]," (A, Msb, K:) or ",[1,"thirsty:"]," (TA:) fem. [of the second] ↓ ",[2,"سَغْبَى"],", (S, K,) pl. ",[2,"سِغَابٌ"],". (K.) You say also, ",[2,"هُوَ سَاغِبٌ"],[2,"لَاغِبٌ"]," (A, TA) and ",[2,"لَغْبَانُ"]," ↓ ",[2,"سَغْبَانُ"]," (TA) [",[1,"He is hungry"]," and ",[1,"fatigued,"]," or ",[1,"fatigued in the utmost degree"],"]. And it is said in a trad., ",[2,"دَخَلَ خَيْبَرَ وَهُمْ"]," ↓ ",[2,"مُسْغِبُونَ"],", expl. as meaning [",[1,"He entered Kheyber"],"] ",[1,"they being hungry."]," (TA.)"]},{"h":"مُسْغِبٌ","t":[": see its pl. in what next precedes."]},{"h":"هُوَ مُسَغَّبٌ لَهُ كَذَا","t":["and ",[2,"مَسَعَّبٌ"]," [the latter written in the CK ",[2,"مُسْغَبٌ"],"] ",[1,"To him is allowed,"]," or ",[1,"permitted, such a thing."]," (K, TA.)"]}]},"maqayis":["السين والغين والباء أصل واحد يدل على الجوع. فالمسغبة: المجاعة، يقال سغب يسغب سغوبا، وهو ساغب وسغبان. قال ابن دريد: قال بعض أهل اللغة: لا يكون السغب إلا الجوع مع التعب. قال وربما سمي العطش سغبا ; وليس بمستعمل."],"mufradat":["قال تعالى: أو إطعام في يوم ذي مسغبة [البلد/ 14] ، من السغب، وهو الجوع مع التعب، وقد قيل: في العطش مع التعب، يقال: سغب سغبا وسغوبا ، وهو ساغب، وسغبان، نحو: عطشان."]}