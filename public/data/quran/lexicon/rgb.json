[1,"A thing desired,"]," or ",[1,"wished for;"]," (K;) as also ↓ ",[2,"رَغْبَةٌ"],": (Ham p. 501:) ",[1,"a thing of high account"]," or ",[1,"estimation; that is desired,"]," or ",[1,"wished for:"]," pl. ",[2,"رَغَائِبُ"],". (A, Mgh.) You say, ",[2,"إِنَّهُ لَوَهُوبٌ"],", ",[2,"لِكُلِّ رَغِيبَةٍ"],", i. e. [",[1,"Verily he is a liberal giver"],"] ",[1,"of everything that is desired."]," (TA.) [And ↓ ",[2,"رَغْبَى"]," has a similar meaning; for] you say also, ",[2,"أَصَبْتُ"],[2,"مِنْهُ الرَّغْبَى"],", i. e. ",[1,"I obtained from him abundance of what I desired."]," (TA.) ― -b2- ",[1,"A large gift:"]," (S, Mgh, Msb, K:) pl. as above. (S, Mgh, Msb.) A poet (En-Nemir Ibn-Towlab, TA) says, ",[2,"وَمَتَى تُصِبْكَ خَصَاصَةٌ فَٱرْجُ الغِنَى"],[2,"وَإِلَى الَّذِى يُعْطِى الرَّغَائِبَ فَٱرْغَبِ"]," [",[1,"And when poverty befalls thee, then hope thou for competence, and to Him who gives large gifts humble thyself, and make petition"],"]. (S, * TA.) ― -b3- And ",[1,"A large recompense that one desires to obtain"]," [",[1,"in the world to come"],"] ",[1,"by prayer:"]," (El-Kilábee, TA:) or ",[1,"that which is wished for by one who has large hope and who desires much:"]," whence the prayer called ",[2,"صَلَاةُ الرَّغَائِبِ"]," [generally said to be a supererogatory prayer]. (TA.)"]},{"h":"الرُّغَابَى","t":["like ",[2,"الرُّغَامَى"]," (JK, K) and ",[2,"الرُّعَامَى"],", (TA,) ",[1,"What is called the"],[2,"زِيَادَة"],[1,"of the liver."]," (JK, K.)"]},{"h":"رِغِّيبٌ","t":[[1,"Very,"]," or ",[1,"intensely,"]," or ",[1,"exceedingly, desirous of much eating."]," (Msb.) [See also ",[2,"رَغِيبٌ"],".]"]},{"h":"رَاغِبٌ","t":[[1,"Desiring,"]," or ",[1,"wishing;"]," (K;) [as in the phrase ",[2,"رَاغِبٌ فِى كَذَا"],[1,"desiring,"]," or ",[1,"wishing for, such a thing;"],"] and so ↓ ",[2,"مُرْتَغِبٌ"],". (TA.)"]},{"h":"مَرْغَبٌ","t":["[",[1,"A place,"]," or ",[1,"time, of desire"]," or ",[1,"wish:"]," and hence, ",[1,"an object thereof"],"]. You say, ",[2,"خَطَبَ"],[2,"فَأَصَابَ المَرْغَبَ"]," [app. meaning ",[1,"He demanded a woman in marriage, and attained the object of desire"],"]. (A.)"]},{"h":"مُرْغِبٌ","t":["(tropical:) ",[1,"Possessing competence"]," or ",[1,"sufficiency; rich,"]," or ",[1,"wealthy;"]," (K, TA;) ",[1,"possessing much property."]," (JK, TA.)"]},{"h":"مَرْغَبَةٌ","t":[": see ",[2,"مَرَاغِبُ"],"."]},{"h":"مَرْغُوبٌ فِيهِ","t":["[ ",[1,"Desired,"]," or ",[1,"wished for."]," ― -b2- ",[2,"مَرْغُوبٌ"],[2,"عَنْهُ"],[1,"Not desired,"]," &c. ― -b3- ",[2,"مَرْغُوبٌ إِلَيْهِ"],[1,"Petitioned,"]," &c.: see an ex. voce ",[2,"مَرْهُوبٌ"],".]"]},{"h":"هُوَ مُرَغَّبٌ لَهُ كَذَا وَكَذَا","t":[[1,"To him are allowed,"]," or ",[1,"permitted, such and such things;"]," like ",[2,"مُسَعَّبٌ"]," and ",[2,"مُسَغَّبٌ"],". (TA in art. ",[2,"سعب"],".)"]},{"h":"مَرَاغِبُ","t":["[lit. ",[1,"Causes of desire;"]," sing., if used, ↓ ",[2,"مَرْغَبَةٌ"],", a word of the same class as ",[2,"مَبْخَلَةٌ"]," and ",[2,"مَجْبَنَةٌ"]," &c.: and hence,] ",[1,"things that are eagerly desired,"]," or ",[1,"coveted;"]," syn. ",[2,"أَطْمَاعٌ"]," [which also signifies soldiers' ",[1,"stipends,"]," or ",[1,"allowances"],"]: (TA:) and (TA) ",[1,"things that are desired to be gained for subsistence,"]," or ",[1,"sustenance; i. q."],[2,"مضطربات لِلْمَعَاشِ"],". (K, TA. [In the CK, the former of the two nouns in this explanation is ",[2,"مُضْطَرِبات"],": in two MS. copies of the K, it is without the syll. signs: the right reading is evidently ",[2,"مُضْطَرَبَات"],", syn. with ",[2,"مُكْتَسَبَات"],": Freytag renders the explanation ",[1,"personæ quæ in rebus quæ spectant ad victum perturbatæ et anxiæ sunt;"]," deriving this meaning from the rendering in the TK: Golius, with a near approach to correctness, renders it ",[1,"res ad sustentandam vitam necessariæ;"]," but he has given this explanation as on the authority of J, by whom it is not mentioned; and has put ",[2,"مَرَاغِبٌ"]," for ",[2,"مَرَاغِبُ"],".])"]},{"h":"مُرَاغِبٌ","t":[": see ",[2,"رَغِيبٌ"],"."]},{"h":"مُرْتَغِبٌ","t":[": see ",[2,"رَاغِبٌ"],". ― -b2- See also ",[2,"رَغِيبٌ"],", last sentence. ― -b3- Also (assumed tropical:) ",[1,"A large, big, bulky,"]," or ",[1,"corpulent,"]," man. (JK.)"]}]},"maqayis":["الراء والغين والباء أصلان: أحدهما طلب لشيء والآخر سعة في شيء.","فالأول الرغبة في الشيء: الإرادة له. رغبت في الشيء. فإذا لم ترده قلت رغبت عنه. ويقال من الرغبة: رغب يرغب رغبا ورغبا ورغبة ورغبى مثل شكوى.","والآخر الشيء الرغيب: الواسع الجوف. يقال حوض رغيب، وسقاء رغيب. ويقال فرس رغيب الشحوة. والرغيبة: العطاء الكثير، والجمع رغائب. قال: وإلى الذي يعطي الرغائب فارغب والرغاب: الأرض الواسعة. وقد رغبت رغبا."],"mufradat":["أصل الرغبة: السعة في الشيء، يقال: رغب الشيء: اتسع ، وحوض رغيب، وفلان رغيب الجوف، وفرس رغيب العدو. والرغبة والرغب والرغبى: السعة في الإرادة قال تعالى: ويدعوننا رغبا ورهبا [الأنبياء/ 90] ، فإذا قيل: رغب فيه وإليه يقتضي الحرص عليه، قال تعالى: إنا إلى الله راغبون [التوبة/ 59] ، وإذا قيل: رغب عنه اقتضى صرف الرغبة عنه والزهد فيه، نحو قوله تعالى: ومن يرغب عن ملة إبراهيم [البقرة/ 130] ، أراغب أنت عن آلهتي [مريم/ 46] ، والرغيبة: العطاء الكثير، إما لكونه مرغوبا فيه، فتكون مشتقة من الرغبة، وإما لسعته، فتكون مشتقة من الرغبة بالأصل، قال الشاعر: 193- يعطي الرغائب من يشاء ويمنع"]}