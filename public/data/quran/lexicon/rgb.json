or ",[1,"who prays,"]," or ",[1,"supplicates, with humility"]," or ",[1,"abasement,"]," or ",[1,"with sincerity"]," or ",[1,"earnestness"]," or ",[1,"energy:"]," or ",[1,"who humbles,"]," or ",[1,"abases, himself, and makes petition:"]," originally an inf. n. of ",[2,"رَغِبَ إِلَيْهِ"],"; or] from ",[2,"الرَّغْبَةُ"],". (S, TA. [In one copy of the former erroneously written ",[2,"رَغَبُوبٌ"],"; in another, ",[2,"رَغْبُوبٌ"],"; and in another, omitted.])"]},{"h":"رُغْبَانَةٌ","t":["The [",[1,"knot called"],"] ",[2,"سَعْدَانَة"],[1,"of a sandal;"]," (K;) i. e. the ",[1,"knot beneath the"]," [",[1,"appertenance called"],"] ",[2,"شِسْع"]," [",[1,"which passes through the sole and between two of the toes, and to which the"],[2,"شِرَاكَ"],", also called ",[2,"زِمَام"],", ",[1,"is attached"],"]. (TA.)"]},{"h":"أَرْضٌ رَغَابٌ","t":["(A'Obeyd, ISk, S, K) and ↓ ",[2,"رُغُبٌ"]," (K) (assumed tropical:) ",[1,"Land that is soft,"]," (A'Obeyd, S, K, TA,) ",[1,"and wide, with even,"]," or ",[1,"sandy, soil:"]," (K, TA:) or (S, K, TA) ",[1,"that takes much water;"]," (TA;) ",[1,"that will not flow unless in consequence of much rain."]," (ISk, S, K, TA.)"]},{"h":"رَغِيبٌ","t":["(assumed tropical:) ",[1,"Wide,"]," or ",[1,"ample;"]," applied in this sense to a watering-trough or tank, and to a skin for water or milk, (S, TA,) &c.: pl. ",[2,"رِغَابٌ"]," (TA) and ",[2,"رُغُبٌ"],". (L in art. ",[2,"أسد"],".) You say also ↓ ",[2,"طَرِيقٌ رَغِبٌ"]," (assumed tropical:) ",[1,"A wide road:"]," pl. ",[2,"رُغُبٌ"],". (TA.) And ",[2,"مَكَانٌ"]," ↓ ",[2,"مُرَاغِبٌ"]," (assumed tropical:) ",[1,"A wide,"]," or ",[1,"an ample, place."]," (TA.) And ↓ ",[2,"وَادٍ رُغُبٌ"]," (assumed tropical:) ",[1,"A wide valley;"]," (TA;) [and] so ",[2,"وَادٍ رَغِيبٌ"],": (JK:) or (tropical:) ",[1,"a wide valley, that takes much water;"]," as also ",[2,"رَغِيبٌ"],"; (AHn, K;) ",[1,"contr. of"],[2,"وَادٍ زهِيدٌ"],". (TA.) And ",[2,"طَعْنَةٌ رَغِيبَةٌ"]," (assumed tropical:) ",[1,"A wide wound inflicted with a spear