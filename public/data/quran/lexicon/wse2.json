{"r":"wsE","lane":{"p":3052,"e":[{"h":"وَسِعَ الإِنَآءُ المَتَاعَ","t":["[",[1,"The vessel was sufficient in its capacity"]," or ",[1,"dimensions,"]," or ",[1,"sufficiently capacious,"]," or ",[1,"large, for the goods"],"]; and ",[2,"المَكَانُ"],[2,"القَوْمَ"]," [",[1,"the place for the company of men"],"]. (Msb.) ",[2,"لَا يَسَعُكَ ان تَفْعَلَ كَذَا"],[1,"It is not in thy power,"]," or ",[1,"proper for thee,"]," (MA,) or ",[1,"allowable for thee,"]," (Mgh, Msb,) ",[1,"to do such a thing."]," (MA, Mgh, Msb.) ― -b2- ",[2,"وَسَعَ عَلَيْهِ رِزْقَهُ"],", aor. ",[2,"يَوْسَعُ"],"; and ↓ ",[2,"أَوْسَعَهُ"],", and ↓ ",[2,"وَسَّعَهُ"],"; ",[1,"He"]," (God) ",[1,"made his means of subsistence ample and abundant."]," (Msb.)"],"f":"1"},{"h":"وَسَّعَ","t":[[1,"He made wide, broad, spacious, roomy,"]," or ",[1,"ample."]," ― -b2- ",[2,"وَسَّعَ لَهُ فِى المَجْلِسِ"],[1,"He made room, or ample space, for him in the sitting-place."]," (S, art. ",[2,"فسح"],".) ― -b3- [And so] ",[2,"فِى المَجْلِسِ"]," ↓ ",[2,"تَوَاسَّعُوا"],[1,"They made room, or ample space,"]," [",[1,"one for another,"],"] ",[1,"in the sitting-place."]," (S, art. ",[2,"فسح"],".) ― -b4- ",[2,"وَسَّعَ عَلَيْهِ"],", for ",[2,"وَسَّعَ عَلَيْهِ رِزْقَهُ"],", ",[1,"He"]," (God) ",[1,"amplified, enlarged,"]," or ",[1,"made ample"]," or ",[1,"plentiful, his means of subsistence; contr. of"],[2,"ضَيَّقَ"],". ― -b5- See 1, and 4."],"f":"2"},{"h":"أَوْسَعَهُ الشَّىْءَ","t":["[",[1,"He made,"]," or ",[1,"rendered, the thing ample,"]," or ",[1,"free from straitness, to him;"],"] ",[1,"he made the thing sufficient for him;"]," syn. ",[2,"جَعَلَهُ"],[2,"يَسَعُهُ"],": (TA:) [",[1,"he gave him sufficiently of the thing;"]," or ",[1,"largely thereof."],"] ― -b2- ",[2,"اَللّٰهُمَّ أَوْسِعْنَا رَحْمَتَكَ"],[1,"O God, make thy mercy sufficient for us;"]," syn. ",[2,"اِجْعَلْهَا تَسَعُنَا"],". (TA.) ― -b3- ",[2,"أَوْسَعَهُ أَمْرَهُ"]," [",[1,"He made,"]," or ",[1,"rendered, his state,"]," or ",[1,"case,"]," or ",[1,"affair, ample,"]," or ",[1,"free from straitness, to him"],"]. (S, art. ",[2,"فرش"],".) See ",[2,"فَرَشَهُ"],". ― -b4- ",[2,"أَوْسَعُوا لِلرَّجُلِ"],[1,"They made room, or ample space, for the man,"]," in a place of standing or of sitting. (Msb, voce ",[2,"فَرَجَ"],".) ― -b5- ",[2,"أَوْسَعَ عَلَيْهِ"],", (S, K.) and ↓ ",[2,"وَسَّعَ"],", (K,) ",[1,"He"]," (God) ",[1,"enriched him;"]," or ",[1,"rendered him free from want."]," (S, K.) ― -b6- See 1."],"f":"4"},{"h":"تَوَسَّعَ","t":["[",[1,"He became,"]," or ",[1,"made himself, ample,"]," or ",[1,"abundant, in his circumstances;"]," or ",[1,"in his means of subsistence;"]," for ",[2,"توسّع فِى عَيْشِهِ"],";] ",[1,"i. q."],[2,"تَرَفَّغَ"],". (S, in art. ",[2,"رفغ"],".) ― -b2- ",[2,"تَوَسَّعَ"],[1,"He took a wide, an ample,"]," or ",[1,"a large, range,"],[2,"فِى أَمْرٍ"],", in an affair. ― -b3- ",[2,"تَوَسَّعَ فِى السَّخَآءِ"]," (assumed tropical:) [",[1,"He took a wide,"]," or ",[1,"an ample range,"]," or ",[1,"was profuse, in bounty,"]," or ",[1,"munificence"],"]. (S, K, in art. ",[2,"خرق"],".) ― -b4- ",[1,"It expanded itself, spread out, dilated, widened."]," ― -b5- ",[1,"He expatiated."]," One says, ",[2,"توسّع فِى الدَّارِ"],", and ",[2,"لَهُ سَاحَةٌ يتوسّع فِيهَا"],". (TA, voce ",[2,"تركّح"],".) ― -b6- ",[1,"He strode,"]," in walking. ― -b7- ",[2,"تَوَسَّعُوا فِيهِ حَتَّى أَطْلَقُوهُ"],[2,"عَلَى كَذَا"],[1,"They extended its"]," (a word's) ",[1,"signification,"]," or ",[1,"amplified in respect of it,"]," or rather, ",[1,"took an extended range in using it, so that they applied it to such a thing."]," (The lexicons, &c., passim.) ― -b8- ",[2,"تَوَسَّعَ"],": see ",[2,"تَبَقَّرَ"],"."],"f":"5"},{"h":"اِتَّسَعَ","t":[[1,"It"]," (a man's state, or condition, &c.) ",[1,"became free from straitness,"]," or ",[1,"unstraitened."]," ― -b2- ",[2,"اِتَّسَعَ عَيْشُهُ"]," [",[1,"His means,"]," or ",[1,"circumstances, of life became ample,"]," or ",[1,"plentiful"],"]. (Msb, art. ",[2,"نعم"],".) ― -b3- ",[2,"اِتَّسَعَ"],[1,"It widened, became wide, dilated,"]," or ",[1,"expanded."]," ― -b4- ",[2,"اِتَّسَعَ بَطْنُهُ"],[1,"His belly became wide, or distended."]," ― -b5- ",[2,"اِتَّسَعَ لِأَمْرٍ"],[1,"He was capable of doing a thing."]," An instance occurs in the TA, voce ",[2,"أَوْهَبَ"],". ― -b6- ",[2,"اِتِّسَاعُ البِئْرِ"],[1,"i. q."],[2,"جِرَابُهَا"]," [",[1,"The interior of the well"],"]. (K, art. ",[2,"جرب"],".) See also 5, in art. ",[2,"عقد"],". ― -b7- ",[2,"اِتَّسَعَ الخَرْقُ عَلَى الرَّاقِعِ"],[1,"The hole was wide to the pitcher:"]," see ",[2,"خَرْقٌ"],". ― -b8- ",[2,"اِتِّسَاعٌ"],[1,"Extension of the signification"]," of a word or phrase: ",[1,"an amplification."]," (The lexicons, &c., passim.)"],"f":"8"},{"h":"سَعَةٌ","t":[[1,"Width; breadth; extent,"]," or ",[1,"space, from side to side."]," See ",[2,"سَدِيلٌ"],". ― -b2- ",[2,"سَعَةٌ العَيْشِ"],[1,"Ampleness of the means,"]," or ",[1,"circumstances, of life; an unstraitened,"]," or ",[1,"a plentiful, state of life."]," ― -b3- ",[2,"سَعَةٌ"]," [",[1,"Ample scope for action, &c.:"]," and ",[1,"a state in which is ample scope for action, &c.:"]," see ",[2,"نَفَسٌ"],", and ",[2,"مِعْرَاضٌ"],":] ",[1,"richness,"]," or ",[1,"wealthiness,"]," or ",[1,"competence:"]," and ",[1,"capacity,"]," or ",[1,"power,"]," or ",[1,"ability:"]," (S, K:) and ",[1,"plentifulness and"]," [consequently] ",[1,"easiness"]," of life. (TA.) ― -b4- ",[2,"سَعَةُ الصَّدْرِ"],[1,"i. q."],[2,"سَعَةُ"],[2,"الخُلُقِ"],". (Har, p. 194.) ― -b5- ",[2,"لَكَ عَنْهُ سَعَةٌ"],": see ",[2,"رُدْحَةٌ"],". ― -b6- ",[2,"يَجُوزُ فِى السَّعَةِ"],[1,"It is allowable absolutely, in other cases than those of poetical necessity."]," (IbrD.)"]},{"h":"وَسَاعٌ","t":["A horse ",[1,"wide in step:"]," (S, K:) or ",[1,"i. q."],[2,"جَوَادٌ"],". (K.)"]},{"h":"وَسِيعٌ","t":["pl. ",[2,"وِسَاعٌ"],": see ",[2,"أَرِيضء"]," in art. ",[2,"أرض"],"."]},{"h":"عَيْشٌ وَاسِعٌ","t":[[1,"A life ample in its means"]," or ",[1,"circumstances; unstraitened,"]," or ",[1,"plentiful."]," ― -b2- ",[2,"وَاسِعٌ"],[1,"Having power,"]," or ",[1,"ability:"]," (Bd, iv. 129:) or rather, ",[1,"having ample power"]," or ",[1,"ability; powerful."]," See Ham, p. 609. ― -b3- ",[2,"نَفْسٌ وَاسِعٌ"],": see ",[2,"رَابِطٌ"],". ― -b4- ",[2,"خُلُقٌ وَاسِعٌ"]," (assumed tropical:) ",[1,"A large,"]," or ",[1,"liberal, disposition:"]," see ",[2,"بَارِجٌ"],". ― -b5- ",[2,"وَاسِعُ الخُلُقِ"]," (tropical:) ",[1,"Large,"]," or ",[1,"liberal, in disposition."]," ― -b6- ",[2,"وَاسِعُ الصَّدْرِ"],": see ",[2,"مَجَمٌّ"],". ― -b7- ",[2,"وَاسِعُ"],[2,"الجَرْىِ"]," (S voce ",[2,"سَهْبٌ"],", applied to a horse,) ",[1,"Widestepping"]," [",[1,"in running"],"]. (So expl. in the PS.)"]},{"h":"أَوْسَعُ","t":[[1,"Wider,"]," or ",[1,"widest:"]," see 3 in art. ",[2,"خلط"],"."]},{"h":"مُوَسَّعٌ عَلَيْهِ","t":[[1,"Amply,"]," or ",[1,"abundantly, provided with the means of subsistence."]]},{"h":"مُتَّسَعٌ","t":[[1,"Width; extent; ampleness of space,"]," and ",[1,"of quantity:"]," properly ",[1,"a place of width,"]," or ",[1,"spaciousness."]," See ",[2,"نُفْسَةٌ"]," and ",[2,"مَبْسَطٌ"],"."]}]},"maqayis":["الواو والسين والعين: كلمة تدل على خلاف الضيق والعسر. يقال وسع الشيء واتسع. والوسع: الغنى. والله الواسع أي الغني. والوسع: الجدة والطاقة. وهو ينفق على قدر وسعه. وقال تعالى في السعة: {لينفق ذو سعة من سعته} [الطلاق: 7] . وأوسع الرجل: كان ذا سعة. والفرس الذريع الخطو: وساع."],"mufradat":["السعة تقال في الأمكنة، وفي الحال، وفي الفعل كالقدرة والجود ونحو ذلك. ففي المكان نحو قوله: إن أرضي واسعة [العنكبوت/ 56] ، ألم تكن أرض الله واسعة [النساء/ 97] ، وأرض الله واسعة [الزمر/ 10] وفي الحال قوله تعالى: لينفق ذو سعة من سعته [الطلاق/ 7] وقوله: ومتعوهن على الموسع قدره [البقرة/ 236] والوسع من القدرة: ما يفضل عن قدر المكلف. قال تعالى: لا يكلف الله نفسا إلا وسعها [البقرة/ 286] تنبيها أنه يكلف عبده دوين ما ينوء به قدرته، وقيل: معناه يكلفه ما يثمر له السعة. أي: جنة عرضها السموات والأرض كما قال: يريد الله بكم اليسر ولا يريد بكم العسر [البقرة/ 185] وقوله: وسع ربنا كل شيء علما [الأعراف/ 89] فوصف له نحو: أحاط بكل شيء علما [الطلاق/ 12] وقوله: والله واسع عليم [البقرة/ 268] ، وكان الله واسعا حكيما [النساء/ 130] فعبارة عن سعة قدرته وعلمه ورحمته وإفضاله كقوله: وسع ربي كل شيء علما [الأنعام/ 80] ورحمتي وسعت كل شيء [الأعراف/ 156] ، وقوله: وإنا لموسعون [الذاريات/ 47] فإشارة إلى نحو قوله: الذي أعطى كل شيء خلقه ثم هدى [طه/ 50] ووسع الشيء: اتسع. والوسع: الجدة والطاقة، ويقال: ينفق على قدر وسعه.","وأوسع فلان: إذا كان له الغنى، وصار ذا سعة، وفرس وساع الخطو: شديد العدو."]}