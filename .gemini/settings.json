{
	"hooks": {
		"BeforeTool": [
			{
				"matcher": "^run_shell_command$",
				"hooks": [
					{
						"name": "impeccable-session",
						"type": "command",
						"command": "[ ! -f '/home/bilal/.gemini/skills/impeccable/scripts/impeccable' ] || '/home/bilal/.gemini/skills/impeccable/scripts/impeccable' hook",
						"timeout": 5000
					}
				]
			}
		],
		"AfterAgent": [
			{
				"hooks": [
					{
						"name": "impeccable-completion",
						"type": "command",
						"command": "[ ! -f '/home/bilal/.gemini/skills/impeccable/scripts/impeccable' ] || '/home/bilal/.gemini/skills/impeccable/scripts/impeccable' hook",
						"timeout": 30000
					}
				]
			}
		]
	}
}
